{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/layout.js": {
      "maxDuration": 10
    },
    "api/scores.js": {
      "maxDuration": 10
    },
    "api/usage.js": {
      "maxDuration": 10
    },
    "api/projects.js": {
      "maxDuration": 10
    },
    "api/project-layout.js": {
      "maxDuration": 10
    },
    "api/billing.js": {
      "maxDuration": 10
    },
    "api/stripe-webhook.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "query",
          "key": "obs"
        }
      ],
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    }
  ]
}
