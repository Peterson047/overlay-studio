# Server-side secrets, configured separately for each deployment environment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Accounts and private projects. Public values may be included in the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server only. Never use a VITE_ prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe sandbox. Live keys are rejected unless explicitly enabled later.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_ALLOW_LIVE=false

# Public production URL used by the SEO build.
SITE_URL=

# Optional live scores.
FOOTBALL_DATA_TOKEN=
FOOTBALL_DATA_COMPETITION=WC

# Only set when hosting the API on a separate origin.
# VITE_LAYOUT_API=https://your-api.example/api
