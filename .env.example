# Server-side secrets, configured separately for each deployment environment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Accounts and private projects. Public values may be included in the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server only. Never use a VITE_ prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe sandbox. Live keys are rejected unless explicitly enabled later.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
# Optional dedicated one-time BRL price ID for 12-month Pix (defaults to inline R$ 249,00 price_data).
STRIPE_PRO_PIX_PRICE_ID=
STRIPE_ALLOW_LIVE=false

# Server-only owner authorization for exclusive kits (comma-separated emails and/or Supabase user UUIDs).
QORP_OWNER_EMAILS=
QORP_OWNER_USER_IDS=

# Public production URL used by the SEO build.
SITE_URL=

# Optional live scores.
FOOTBALL_DATA_TOKEN=
FOOTBALL_DATA_COMPETITION=WC

# Only set when hosting the API on a separate origin.
# VITE_LAYOUT_API=https://your-api.example/api

# Seller identification shown on Terms/Privacy (Decreto 7.962/2013).
# Set in Vercel; kept out of the public repo.
VITE_LEGAL_NAME=
VITE_LEGAL_DOC=
VITE_LEGAL_ADDRESS=
